# Server-only Groq configuration
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Server-only Firebase Admin credential
FIREBASE_CREDENTIALS_PATH=./firebase/serviceAccountKey.json

# Public Firebase Web App config used by the browser login.
# Firebase Console -> Project settings -> Your apps -> Web app
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

OCR_ENABLED=true
OCR_LANGUAGE=eng
MAX_CV_FILE_SIZE_MB=10
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
